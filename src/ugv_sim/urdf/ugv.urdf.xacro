<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema" name="ugv">
  <xacro:arg name="use_cad" default="false"/>
  <xacro:arg name="mesh_dir" default=""/>
  <!-- CAD tire envelope; replace with measured physical mecanum dimensions. -->
  <xacro:property name="radius" value="0.03446133"/>
  <xacro:property name="track" value="0.156907572"/>
  <xacro:property name="wheelbase" value="0.134780014"/>
  <xacro:property name="wheel_width" value="0.025"/>
  <xacro:property name="wheel_mass" value="0.045"/>
  <material name="body"><color rgba="0.13 0.34 0.45 1"/></material>
  <material name="tire"><color rgba="0.08 0.08 0.09 1"/></material>
  <material name="sensor"><color rgba="0.15 0.15 0.18 1"/></material>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${radius}"/>
  </joint>
  <link name="base_link">
    <!-- Estimated mass and box inertia, not inferred from mixed-material CAD. -->
    <inertial>
      <origin xyz="0 0 0.035"/><mass value="0.8"/>
      <inertia ixx="0.00167" ixy="0" ixz="0" iyy="0.00321" iyz="0" izz="0.00417"/>
    </inertial>
    <visual>
      <xacro:if value="$(arg use_cad)">
        <geometry><mesh filename="file://$(arg mesh_dir)/chassis.stl"/></geometry>
      </xacro:if>
      <xacro:unless value="$(arg use_cad)">
        <origin xyz="0.007 0 0.035"/><geometry><box size="0.21 0.14 0.10"/></geometry>
      </xacro:unless>
      <material name="body"/>
    </visual>
    <collision>
      <origin xyz="0.007 0 0.035"/><geometry><box size="0.21 0.14 0.10"/></geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name x y friction_y">
    <link name="${name}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*radius*radius+wheel_width*wheel_width)/12}"
                 iyy="${wheel_mass*radius*radius/2}"
                 izz="${wheel_mass*(3*radius*radius+wheel_width*wheel_width)/12}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
      <visual>
        <xacro:if value="$(arg use_cad)">
          <geometry><mesh filename="file://$(arg mesh_dir)/${name}_wheel.stl"/></geometry>
        </xacro:if>
        <xacro:unless value="$(arg use_cad)">
          <origin rpy="${pi/2} 0 0"/>
          <geometry><cylinder radius="${radius}" length="${wheel_width}"/></geometry>
        </xacro:unless>
        <material name="tire"/>
      </visual>
      <!-- Simplified mecanum contact; diagonal friction is defined below. -->
      <collision><geometry><sphere radius="${radius}"/></geometry></collision>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${y} 0"/><axis xyz="0 1 0"/>
      <limit effort="0.4" velocity="30"/><dynamics damping="0.001"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">1 ${friction_y} 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>
  <xacro:wheel name="front_left"
               x="${wheelbase/2}" y="${track/2}"
               friction_y="-1"/>
  <xacro:wheel name="front_right"
               x="${wheelbase/2}" y="${-track/2}"
               friction_y="1"/>
  <xacro:wheel name="rear_left"
               x="${-wheelbase/2}" y="${track/2}"
               friction_y="1"/>
  <xacro:wheel name="rear_right"
               x="${-wheelbase/2}" y="${-track/2}"
               friction_y="-1"/>
  <gazebo>
    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>${track}</wheel_separation><wheelbase>${wheelbase}</wheelbase>
      <wheel_radius>${radius}</wheel_radius>
      <topic>/model/ugv/cmd_vel</topic><odom_topic>/model/ugv/odometry</odom_topic>
      <tf_topic>/model/ugv/tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.35</max_linear_velocity><min_linear_velocity>-0.35</min_linear_velocity>
      <max_angular_velocity>1.2</max_angular_velocity><min_angular_velocity>-1.2</min_angular_velocity>
      <max_linear_acceleration>0.5</max_linear_acceleration><min_linear_acceleration>-0.5</min_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration><min_angular_acceleration>-1.5</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>
  
  <link name="camera_link" />

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.115 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_frame"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>${pi/3}</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>30</far>
        </clip>
        <camera_info_topic>/camera/camera_info</camera_info_topic>
      </camera>
    </sensor>
  </gazebo>
</robot>
